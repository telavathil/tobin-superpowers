{
  "description": "tobin-superpowers: load hybrid planning preferences at session start; advisory validation of implementation plans after Write/Edit; code standards and a once-per-repo lint baseline check injected into plans, a new-package prompt before installs (PreToolUse); and a one-time stop before a prompt re-writes a large, cold prompt cache (UserPromptSubmit)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-context.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/inject-plan-standards.py",
              "1"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/inject-plan-standards.py",
              "2"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/ask-new-package.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/validate-plan-hook.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/cold-cache-guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
